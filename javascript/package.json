{
  "name": "crystal-ball-markets",
  "version": "2.0.0",
  "description": "A currency converter and gold value calculator for any web page, with the sums and a client for the free Crystal Ball Markets exchange rate and gold price API.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./converter": {
      "types": "./converter.d.ts",
      "default": "./converter.js"
    },
    "./sample": {
      "types": "./sample.d.ts",
      "default": "./sample.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "core.js",
    "converter.js",
    "converter.d.ts",
    "converter-style.js",
    "sample.js",
    "sample.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "currency-converter",
    "exchange-rates",
    "currency",
    "gold-price",
    "gold-calculator",
    "forex",
    "rates-api",
    "widget",
    "free-api",
    "market-data"
  ],
  "homepage": "https://crystalballmarkets.com/markets/rates-api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crystalballmarkets/rates-api-examples.git",
    "directory": "javascript"
  },
  "bugs": {
    "url": "https://github.com/crystalballmarkets/rates-api-examples/issues"
  },
  "author": "Crystal Ball Markets <support@crystalballmarkets.com> (https://crystalballmarkets.com)",
  "license": "MIT",
  "scripts": {
    "test": "node test.js"
  }
}
