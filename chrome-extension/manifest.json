{
  "manifest_version": 3,
  "name": "Currency and Gold Converter by Crystal Ball Markets",
  "short_name": "Converter",
  "version": "2.0.0",
  "description": "Convert an amount between currencies, or work out what a weight of gold is worth, without leaving the page you are on.",
  "homepage_url": "https://crystalballmarkets.com/chrome-extension",
  "minimum_chrome_version": "109",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Currency and gold converter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
